  "cards": [
    {
      "dot": "cyan",
      "title": "Checkpoint và khôi phục",
      "items": [
        "Mỗi stage ghi kết quả vào staging/{document_id}/ trước khi chuyển tiếp",
        "Stage thấy output của mình đã có thì bỏ qua — không cần khoá phân tán",
        "staging/ xoá sau 7 ngày; raw/ giữ vĩnh viễn để còn ingest lại được"
      ]
    },
    {
      "dot": "amber",
      "title": "Hàng đợi và nhịp gọi",
      "items": [
        "Hai hàng đợi tách theo tài nguyên: cpu cho S1/S2/S5, llm cho S3/S4",
        "Redis là container thứ 8, không vẽ: chỉ giữ token bucket cho S3 và S4",
        "Không có result backend — documents.status mới là trạng thái bền"
      ]
    },
    {
      "dot": "violet",
      "title": "Đường đọc gọn hơn đường ghi",
      "items": [
        "Một chặng: nhúng câu hỏi, tìm child, gom về parent, ngữ cảnh 8000 token",
        "DISTINCT ON cần parent_id đứng đầu ORDER BY, nếu không sai mà không báo lỗi",
        "page_number nằm ở child nên trích dẫn chỉ chính xác tới mức trang"
      ]
    }
  ]
