# --- Database -----------------------------------------------------------
# Required. No defaults — the app refuses to start with an incomplete set.
# These values are read by both the app and docker-compose.
#
# DB_HOST/DB_PORT are the database as seen *from the host*: the compose file
# publishes Postgres on DB_PORT and overrides both for the api container,
# which reaches the db service on its internal 5432.
DB_HOST=localhost
DB_PORT=5432
DB_USER=rag
DB_PASSWORD=rag
DB_NAME=rag_beginner

# Optional escape hatch: a full DSN wins over the five variables above.
# Useful for managed Postgres, which hands out one ready-made URL.
# DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag_beginner

# --- Application --------------------------------------------------------
APP_NAME=rag-beginner
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

HOST=0.0.0.0
PORT=8000

# --- Infrastructure -----------------------------------------------------
# As seen *from the host*, same convention as DB_HOST above: compose
# overrides these to the service names (rabbitmq, redis, minio, docling)
# for the containers. The defaults in app/config.py are the container
# names, so an in-compose run works with no .env at all.

# In parts, like the database: the broker image reads the user and password
# as its own variables, so keeping them inside a URL would mean two copies
# that drift. The vhost is explicit rather than a trailing slash.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Escape hatch, wins over the five above. A managed broker hands out one URL.
# RABBITMQ_URL=amqps://user:pass@broker.example.com:5671/prod

# Whole URLs on purpose: neither carries a credential compose needs
# separately, and a wrong value fails loudly rather than quietly reaching
# the wrong service.
REDIS_URL=redis://localhost:6379/0
DOCLING_URL=http://localhost:8100
DOCLING_PAGE_TIMEOUT_S=90

# MINIO_HOST/PORT assemble the internal endpoint, so compose can publish
# ${MINIO_PORT} without repeating it. MINIO_PUBLIC_ENDPOINT is the host a
# presigned URL gets signed for; left unset it falls back to the internal
# one, which is right when everything runs on the host. Compose sets it
# for the containers, where the two genuinely differ.
MINIO_SCHEME=http
MINIO_HOST=localhost
MINIO_PORT=9000
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Escape hatch for real S3, which has no host:port to assemble.
# MINIO_ENDPOINT=https://s3.eu-west-1.amazonaws.com

MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_STAGING=staging

# --- LLM ----------------------------------------------------------------
# stub = no network, deterministic output. Switch to openai once a key is
# in place; the key stays commented out here so .env.example never carries
# a credential.
LLM_PROVIDER=stub
# OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536

# --- Limits -------------------------------------------------------------
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=500
MAX_CHUNKS_PER_DOC=5000
ENRICH_BATCH_SIZE=20
EMBED_BATCH_SIZE=100
RL_CHAT_RPM=500
RL_CHAT_TPM=200000
RL_EMBED_RPM=3000
RL_EMBED_TPM=1000000
