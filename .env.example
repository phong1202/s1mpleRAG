# --- Database -----------------------------------------------------------
# Required. No defaults — the app refuses to start with an incomplete set.
# These values are read by both the app and docker-compose.
#
# DB_HOST/DB_PORT are the database as seen *from the host*: the compose file
# publishes Postgres on DB_PORT and overrides both for the api container,
# which reaches the db service on its internal 5432.
DB_HOST=localhost
DB_PORT=5432
DB_USER=rag
DB_PASSWORD=rag
DB_NAME=rag_beginner

# Optional escape hatch: a full DSN wins over the five variables above.
# Useful for managed Postgres, which hands out one ready-made URL.
# DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5433/rag_beginner

# --- Application --------------------------------------------------------
APP_NAME=rag-beginner
ENVIRONMENT=development
LOG_LEVEL=INFO

# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000

HOST=0.0.0.0
PORT=8000

# --- Infrastructure -----------------------------------------------------
# As seen *from the host*, same convention as DB_HOST above: compose
# overrides these to the service names (rabbitmq, redis, minio, chandra)
# for the containers. The defaults in app/config.py are the container
# names, so an in-compose run works with no .env at all.

# In parts, like the database: the broker image reads the user and password
# as its own variables, so keeping them inside a URL would mean two copies
# that drift. The vhost is explicit rather than a trailing slash.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# Escape hatch, wins over the five above. A managed broker hands out one URL.
# RABBITMQ_URL=amqps://user:pass@broker.example.com:5671/prod

# Whole URLs on purpose: neither carries a credential compose needs
# separately, and a wrong value fails loudly rather than quietly reaching
# the wrong service.
REDIS_URL=redis://localhost:6379/0
OCR_URL=http://localhost:8100
# true sends every page through Chandra, not only scans and pages with a
# detected table or image -- best output, one GPU pass per page.
OCR_ALL_PAGES=false

# MINIO_HOST/PORT assemble the internal endpoint, so compose can publish
# ${MINIO_PORT} without repeating it. MINIO_PUBLIC_ENDPOINT is the host a
# presigned URL gets signed for; left unset it falls back to the internal
# one, which is right when everything runs on the host. Compose sets it
# for the containers, where the two genuinely differ.
MINIO_SCHEME=http
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# Escape hatch for real S3, which has no host:port to assemble.
# MINIO_ENDPOINT=https://s3.eu-west-1.amazonaws.com

MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_STAGING=staging

# --- Auth ---
# auto_admin: every request is the seeded admin. No login yet: keep the API on this machine.
AUTH_MODE=auto_admin

# --- LLM ----------------------------------------------------------------
# stub = no network, deterministic output. Switch to openai once a key is
# in place; the key stays commented out here so .env.example never carries
# a credential.
LLM_PROVIDER=stub
# OPENAI_API_KEY=sk-...
OPENAI_CHAT_MODEL=gpt-6-luna
# none | low | medium | high -- reasoning tokens bill as output.
OPENAI_REASONING_EFFORT=low
# The rewriter (R4) only rephrases: same rewrites at "none", in two thirds of the time.
REWRITE_REASONING_EFFORT=none
# The gate (R6): enough to answer, or search again for what is missing.
GATE_REASONING_EFFORT=none
# Reflection (R7): drops the sentences of an answer no source supports.
REFLECT_REASONING_EFFORT=low
OPENAI_EMBED_MODEL=text-embedding-3-large
EMBED_DIMENSIONS=1536

# --- Limits -------------------------------------------------------------
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=500
MAX_CHUNKS_PER_DOC=5000
ENRICH_BATCH_SIZE=20
EMBED_BATCH_SIZE=100
RL_CHAT_RPM=500
RL_CHAT_TPM=200000
RL_EMBED_RPM=3000
RL_EMBED_TPM=1000000

# --- Retrieval (Phase 2) ---
RETRIEVAL_TOP_K=10
RETRIEVAL_OVER_FETCH=50
RETRIEVAL_EF_SEARCH=100
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_KEEP=10
RETRIEVAL_RERANK_CANDIDATES=50
CONTEXT_TOKEN_BUDGET=8000
CONTEXT_ROUND_EXTRA=3000

# Stage flags. All off = R0 behaviour.
# 1: answer from one round of search. 3: R6, the gate may search twice more.
RETRIEVAL_MAX_ITERATIONS=1
RETRIEVAL_BM25_ENABLED=false
RETRIEVAL_RERANK_ENABLED=false
RETRIEVAL_INTENT_ENABLED=false
RETRIEVAL_ROUTER_ENABLED=false
RETRIEVAL_REFLECT_ENABLED=false
WEB_SEARCH_ENABLED=false

# --- Web search (R8) ---
# Tavily, searched only when the gate (R6) found the corpus short after a
# second round: needs RETRIEVAL_MAX_ITERATIONS of at least 2. What it finds
# reaches the answer as external sources, never anything that chooses a tool.
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5
# Comma-separated; empty searches the whole web.
WEB_SEARCH_INCLUDE_DOMAINS=
WEB_SEARCH_TIMEOUT_S=10

# --- Reranker (R3) ---
# Any server speaking the Cohere shape of /rerank.
# The CPU container: leave RERANKER_URL and RERANKER_MODEL UNSET. The API then
# uses http://reranker:8200 inside compose and http://localhost:8200 on the
# host, and the container scores with the model it was built with.
# A hosted model: set all three, e.g. OpenRouter:
#   RERANKER_URL=https://openrouter.ai/api/v1
#   RERANKER_MODEL=qwen/qwen3-reranker-4b
#   RERANKER_API_KEY=sk-or-...
RERANKER_TIMEOUT_S=5
# What the CPU container is built with (docker compose build reranker).
RERANKER_LOCAL_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_LOCAL_BACKEND=onnx
# Quantised for CPUs with AVX-512 VNNI. Without it, use onnx/model_quint8_avx2.onnx.
# Leave empty with RERANKER_LOCAL_BACKEND=torch for a model that ships no ONNX file.
RERANKER_LOCAL_ONNX_FILE=onnx/model_qint8_avx512_vnni.onnx
RERANKER_LOCAL_TRUST_REMOTE_CODE=false
RERANKER_LOCAL_THREADS=8
RERANKER_LOCAL_MAX_WAITING=2
