# FastAPI backend (the repo root's app/). The browser reaches it through the
# /backend/* rewrite in next.config.mjs, never directly.
API_URL=http://localhost:8000

# Origin of the presigned URLs the backend hands out (its MINIO_PUBLIC_ENDPOINT).
# The CSP in proxy.ts lets the browser fetch PDFs from this origin only.
STORAGE_PUBLIC_ORIGIN=http://localhost:9000
