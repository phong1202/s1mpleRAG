# FastAPI backend (the repo root's app/). The browser reaches it through the
# /backend/* rewrite in next.config.mjs, never directly. The PDF viewer's
# bytes route (app/api/documents/[id]/bytes) also calls it server-side and
# then fetches the presigned URL it returns, so this server must be able to
# reach the backend's MINIO_PUBLIC_ENDPOINT too.
API_URL=http://localhost:8000

# Origin of the presigned upload URLs the backend hands out (its
# MINIO_PUBLIC_ENDPOINT). The browser PUTs uploads there, so the CSP in
# proxy.ts allows connecting to this origin, and to no other.
STORAGE_PUBLIC_ORIGIN=http://localhost:9000
